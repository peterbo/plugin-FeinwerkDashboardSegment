{
  "name": "feinwerk/dashboard-segment",
  "description": "FeinwerkDashboardSegment for Matomo: dev/test tooling only",
  "type": "matomo-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Piwik\\Plugins\\FeinwerkDashboardSegment\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Piwik\\Plugins\\FeinwerkDashboardSegment\\tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": false,
    "autoloader-suffix": "FeinwerkDashboardSegment",
    "sort-packages": true
  }
}
